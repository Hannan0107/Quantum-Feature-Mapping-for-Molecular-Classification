{
  "n_valid_rows_before_deduplication": 1687,
  "n_conflicting_structures_removed": 9,
  "n_unique_structures": 1615,
  "n_balanced_molecules": 250,
  "dataset": "BBBP.csv",
  "per_class": 125,
  "n_splits": 10,
  "test_size": 0.25,
  "seed": 42,
  "selector": "chemical_coverage",
  "readout": "z_zz (78 Pauli moments)",
  "arms": [
    {
      "method": "TPSA__baseline",
      "prop": "tpsa_contrib",
      "size_channel": "none",
      "size_weight": 0.4
    },
    {
      "method": "TPSA__size_heavy_atoms",
      "prop": "tpsa_contrib",
      "size_channel": "heavy_atoms",
      "size_weight": 0.4
    },
    {
      "method": "TPSA__size_diameter",
      "prop": "tpsa_contrib",
      "size_channel": "graph_diameter",
      "size_weight": 0.4
    },
    {
      "method": "TPSA__size_radius",
      "prop": "tpsa_contrib",
      "size_channel": "graph_radius",
      "size_weight": 0.4
    },
    {
      "method": "TPSA__size_diameter_w0.8",
      "prop": "tpsa_contrib",
      "size_channel": "graph_diameter",
      "size_weight": 0.8
    },
    {
      "method": "Pauling__baseline",
      "prop": "pauling_en",
      "size_channel": "none",
      "size_weight": 0.4
    },
    {
      "method": "Pauling__size_diameter",
      "prop": "pauling_en",
      "size_channel": "graph_diameter",
      "size_weight": 0.4
    }
  ],
  "classifier_fixed": "StandardScaler + SVC(RBF, C=10)",
  "classifier_nested": "C chosen from {0.1, 1, 10, 100, 1000} by 3-fold AUC inside each training split"
}
