{
  "n_valid_rows_before_deduplication": 1687,
  "n_conflicting_structures_removed": 9,
  "n_unique_structures": 1615,
  "n_balanced_molecules": 250,
  "dataset": "BBBP.csv",
  "per_class": 125,
  "n_splits": 10,
  "test_size": 0.25,
  "seed": 42,
  "readout": "z_zz",
  "arms": [
    {
      "method": "SMILES_ORDER__pauling__global",
      "strategy": "smiles_order",
      "prop": "pauling_en",
      "tail_mode": "global"
    },
    {
      "method": "CANONICAL_TRAVERSAL__pauling__global",
      "strategy": "canonical_traversal",
      "prop": "pauling_en",
      "tail_mode": "global"
    },
    {
      "method": "CHEMICAL_COVERAGE__pauling__global",
      "strategy": "chemical_coverage",
      "prop": "pauling_en",
      "tail_mode": "global"
    },
    {
      "method": "CONNECTED_CORE__pauling__global",
      "strategy": "connected_core",
      "prop": "pauling_en",
      "tail_mode": "global"
    },
    {
      "method": "CONNECTED_CORE__tpsa__global",
      "strategy": "connected_core",
      "prop": "tpsa_contrib",
      "tail_mode": "global"
    },
    {
      "method": "CONNECTED_CORE__pauling__sum",
      "strategy": "connected_core",
      "prop": "pauling_en",
      "tail_mode": "sum"
    }
  ],
  "classifier_fixed": "StandardScaler + SVC(RBF, C=10)",
  "classifier_nested": "C chosen from {0.1, 1, 10, 100, 1000} by 3-fold AUC inside each training split"
}
